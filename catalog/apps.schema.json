{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntdtdt2010-bit.github.io/AllSoftDesktop/apps.schema.json",
  "title": "AllSoft Desktop Catalog v2",
  "type": "object",
  "required": ["catalog_version", "updated_at", "repo", "site_url", "launcher", "profiles", "apps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalog_version": { "const": 2 },
    "updated_at": { "type": "string", "format": "date-time" },
    "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
    "site_url": { "type": "string", "format": "uri" },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_name": { "type": "string" },
        "author": { "type": "string" },
        "subbrand": { "type": "string" },
        "logo_url": { "type": "string" },
        "icon_url": { "type": "string" },
        "primary_color": { "type": "string" },
        "hero_badge": { "type": "string" },
        "hero_title": { "type": "string" },
        "hero_highlight": { "type": "string" },
        "hero_subtitle": { "type": "string" }
      }
    },
    "site_content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nav_apps": { "type": "string" },
        "nav_docs": { "type": "string" },
        "nav_changelog": { "type": "string" },
        "nav_admin": { "type": "string" },
        "hero_badge": { "type": "string" },
        "hero_title": { "type": "string" },
        "hero_highlight": { "type": "string" },
        "hero_subtitle": { "type": "string" },
        "btn_download_primary": { "type": "string" },
        "btn_download_portable": { "type": "string" },
        "hero_version_note": { "type": "string" },
        "ps_title": { "type": "string" },
        "ps_note": { "type": "string" },
        "ps_admin_link": { "type": "string" },
        "profiles_eyebrow": { "type": "string" },
        "profiles_title": { "type": "string" },
        "profiles_subtitle": { "type": "string" },
        "catalog_eyebrow": { "type": "string" },
        "catalog_title": { "type": "string" },
        "catalog_search_placeholder": { "type": "string" },
        "footer_desc": { "type": "string" },
        "footer_nav_title": { "type": "string" },
        "footer_infra_title": { "type": "string" },
        "footer_copyright": { "type": "string" }
      }
    },
    "launcher": {
      "type": "object",
      "required": ["name", "version", "release_url", "downloads"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "release_url": { "type": "string", "format": "uri" },
        "downloads": {
          "type": "object",
          "required": ["windows", "windows_portable"],
          "additionalProperties": false,
          "properties": {
            "windows": { "type": "string", "format": "uri" },
            "windows_portable": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "apps"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "apps": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true }
        }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/app" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "app": {
      "type": "object",
      "required": ["id", "name", "description", "category", "source", "version", "dependencies", "uninstall", "changelog_url", "detect"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "hidden": { "type": "boolean" },
        "source": { "enum": ["winget", "direct"] },
        "winget": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "scope": { "enum": ["machine", "user"] }
          }
        },
        "direct": {
          "type": "object",
          "required": ["url", "installer_type", "silent_args", "sha256"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "installer_type": { "enum": ["exe", "msi"] },
            "silent_args": { "$ref": "#/definitions/stringArray" },
            "sha256": {
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }]
            }
          }
        },
        "version": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
        "uninstall": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["winget", "registry", "none"] },
            "args": { "$ref": "#/definitions/stringArray" }
          }
        },
        "changelog_url": { "type": "string", "format": "uri" },
        "docs_slug": { "type": "string" },
        "detect": {
          "type": "object",
          "required": ["display_names", "registry_keys", "install_paths"],
          "additionalProperties": false,
          "properties": {
            "display_names": { "$ref": "#/definitions/stringArray" },
            "registry_keys": { "$ref": "#/definitions/stringArray" },
            "install_paths": { "$ref": "#/definitions/stringArray" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "source": { "const": "winget" } } }, "then": { "required": ["winget"] } },
        { "if": { "properties": { "source": { "const": "direct" } } }, "then": { "required": ["direct"] } }
      ]
    }
  }
}
